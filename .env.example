# Tolid-mohtava environment template — copy to .env (or set machine-wide) and fill.
# NEVER commit the real .env. The panel reads these from the process environment.
# PowerShell: [Environment]::SetEnvironmentVariable('NAME','value','User')

# ── Panel (optional overrides) ────────────────────────────────
TEHNET_PANEL_PORT=8766
# TEHNET_PANEL_DB=D:\tolid\data\content.sqlite   # custom DB path
# TEHNET_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe    # if not on PATH/winget

# ── Panel authentication (recommended before any remote access) ─
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong

# ── AI providers (OpenAI-compatible) ─────────────────────────
# LM Studio local (default): server on 127.0.0.1:1234
# model set from panel Settings; default qwen2.5-7b-instruct (fallback meta-llama-3-8b-instruct)
# Remote (optional): OPENAI_API_KEY / OPENAI_BASE_URL

# ── Whisper model: small | medium | large-v3 (default medium, benchmarked) ──
WHISPER_MODEL=medium

# ── WordPress drafts (Application Passwords) ──────────────────
WP_TEHNET_USER=
WP_TEHNET_APP_PASSWORD=
WP_MYTEL_USER=
WP_MYTEL_APP_PASSWORD=

# ── Notifications ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Analytics / SEO (OAuth; least privilege) ──────────────────
# YouTube: youtube.upload youtube.readonly
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# GA4 Data API
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
# GSC service account JSON path (webmasters.readonly)
GSC_CREDENTIALS=
# Google Ads Keyword Planner
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Meta
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
# Gemini image generation
GOOGLE_AI_API_KEY=

# ── Onboarding & revocation quick reference (details: docs/CREDENTIALS-GUIDE.fa.md) ──
# WordPress : obtain = wp-admin → Users → Profile → Application Passwords | revoke = Revoke button there
# Telegram  : obtain = @BotFather /token | revoke = /revoke in BotFather
# YouTube   : scopes youtube.upload youtube.readonly | revoke = https://myaccount.google.com/permissions
# GA4/GSC/Ads: Google Cloud OAuth/service account | revoke = remove in Cloud Console + myaccount permissions
# Meta      : obtain = developers.facebook.com apps | revoke = App dashboard → remove
# LinkedIn  : scope w_member_social | revoke = LinkedIn Settings → Data privacy → Permitted services
# Gemini    : obtain = aistudio.google.com API key | revoke = delete key there

OAUTH_REDIRECT_BASE=http://127.0.0.1:8767

# ── Optional integrations ─────────────────────────────────────
# RUFLO_ENDPOINT=http://127.0.0.1:8117
# RUFLO_PINNED_VERSION=
# SCREAMING_FROG_PATH=C:\Program Files\Screaming Frog SEO Spider\ScreamingFrogSEOSpider.exe
# SERP_API_KEY=
